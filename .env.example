# BibleQuest — environment variables
# Copy to .env.local for local development. NEVER commit real secrets.
#
# V1 runs fully WITHOUT any of these (guest mode, local-first). They enable
# optional account sync, analytics, payments, and email as those land.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (optional in V1) ---
# The anon key is safe for the browser. The service role key is SERVER-ONLY
# and must NEVER be exposed to the client. See docs/SECURITY.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Analytics (optional; privacy-first, no journal text ever) ---
# Events post to the Plausible Events API (cookieless, no fingerprinting)
# when BOTH the flag and domain are set, e.g. NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# biblequest.co. Analytics remains off until a user explicitly opts in under
# Settings → Privacy & data. Offline events queue locally (maximum 50), are
# re-sanitized before retry, and are cleared immediately on opt-out.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Self-hosted Plausible? Use an HTTPS origin only (no path/query/hash/credentials).
# Invalid hosts silently disable analytics. Defaults to https://plausible.io.
NEXT_PUBLIC_PLAUSIBLE_HOST=

# --- Monitoring (optional) ---
SENTRY_DSN=

# --- Payments (scaffold only; nothing spiritual is ever gated) ---
# RevenueCat powers the Plus supporter tier. Billing is deny-by-default: a key
# alone never enables checkout. Keep coming-soon for normal/production builds;
# use sandbox + a Test Store public key only for local simulated purchases.
NEXT_PUBLIC_REVENUECAT_BILLING_MODE=coming-soon
# Browser-safe PUBLIC key only — NEVER a secret key. Do not commit a value.
#   sandbox → Test Store public key ("test_…")
#   live    → Web Billing public key ("rcb_…"), only after every release gate
NEXT_PUBLIC_REVENUECAT_PUBLIC_KEY=
# Optional — only set if you rename the entitlement in the dashboard.
NEXT_PUBLIC_REVENUECAT_PLUS_ENTITLEMENT=BibleQuest Plus

# --- Email lifecycle (optional, later) ---
RESEND_API_KEY=

# --- AI Guide (future only; scaffold-only in V1) ---
ANTHROPIC_API_KEY=
