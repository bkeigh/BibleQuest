# BibleQuest — environment variables
# Copy to .env.local for local development. NEVER commit real secrets.
#
# V1 runs fully WITHOUT any of these (guest mode, local-first). They enable
# optional account sync, analytics, and payments.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# SERVER-ONLY approved rollback commit. Exactly 40 hexadecimal characters.
# Leave unset until the rollback authority approves a database/PWA-compatible
# target; the health/evidence contract reports only the validated SHA.
BIBLEQUEST_ROLLBACK_SHA=

# --- Supabase (optional in V1) ---
# The publishable/anon key is safe for the browser. Never place service-role or
# direct database credentials in the application environment. See SECURITY.md
# and docs/FOUNDER_API_SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Fail closed unless this exact build target has passed the complete account
# sync migration, RLS, restore, auth-provider, and PWA rollout gates.
NEXT_PUBLIC_ACCOUNT_SYNC_ENABLED=false

# --- Analytics (optional; privacy-first, no journal text ever) ---
# Events post to the Plausible Events API (cookieless, no fingerprinting)
# when BOTH the flag and domain are set. For production use the canonical
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=www.biblequest.co. Analytics remains off until a
# user explicitly opts in under Settings → Privacy & data. Offline events queue
# locally (maximum 50), are re-sanitized before retry, and are cleared
# immediately on opt-out.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Self-hosted Plausible? Use an HTTPS origin only (no path/query/hash/credentials).
# Invalid hosts silently disable analytics. Defaults to https://plausible.io.
NEXT_PUBLIC_PLAUSIBLE_HOST=

# --- Payments (optional and deny-by-default; nothing spiritual is ever gated) ---
# RevenueCat powers the Plus supporter tier. Billing is deny-by-default: a key
# alone never enables checkout. Keep coming-soon for normal/production builds;
# use sandbox + a Test Store public key only for local simulated purchases.
NEXT_PUBLIC_REVENUECAT_BILLING_MODE=coming-soon
# Browser-safe PUBLIC key only — NEVER a secret key. Do not commit a value.
#   sandbox → Test Store public key ("test_…")
#   live    → Web Billing public key ("rcb_…"), only after every release gate
NEXT_PUBLIC_REVENUECAT_PUBLIC_KEY=
# Optional — only set if you rename the entitlement in the dashboard.
NEXT_PUBLIC_REVENUECAT_PLUS_ENTITLEMENT=BibleQuest Plus

# Optional one-time support. SERVER-ONLY even though Stripe Payment Links are
# public: UI links to /support, and the server validates + redirects. Use one
# exact HTTPS Payment Link such as https://buy.stripe.com/... with no query or
# fragment. Missing/malformed values show an explicit unavailable state.
STRIPE_DONATION_URL=

# --- Bible editions ---
# The default KJV uses the keyless HelloAO Free Use Bible API; bundled WEB is
# the offline fallback. Neither needs an environment variable.
#
# Future licensed editions (optional; do not use API.Bible's non-commercial
# Starter access for monetized BibleQuest):
# SERVER-ONLY API.Bible key. BibleQuest Plus is commercial: add only exact Bible
# ids that the provider/publisher has licensed for this app's commercial plan.
# Catalog visibility alone is not permission; WEB is bundled and needs no key.
API_BIBLE_API_KEY=
API_BIBLE_COMMERCIALLY_LICENSED_BIBLE_IDS=

# Supabase Auth email is configured in the Supabase/SMTP provider dashboards;
# it does not read a Resend key from this app. Lifecycle email, external AI, and
# third-party error-reporting variables are intentionally absent until runtime
# integrations with privacy controls actually exist.
