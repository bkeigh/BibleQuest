# BibleQuest — environment variables
# Copy to .env.local for local development. NEVER commit real secrets.
#
# V1 runs fully WITHOUT any of these (guest mode, local-first). They enable
# optional account sync, analytics, and payments.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Generic local and hosted builds remain web; the reviewed release command pins
# the native target and production hosted origin without editing this file.
NEXT_PUBLIC_APP_PLATFORM=web
# NEXT_PUBLIC_NATIVE_HOSTED_ORIGIN=https://www.biblequest.co
# NEXT_PUBLIC_NATIVE_AUTH_CALLBACK_URL=biblequest://auth/callback
# SERVER-ONLY latch admitting the reviewed iOS app origin past the API origin
# guards. Off unless the value is exactly "true" (no NEXT_PUBLIC_ — the origin
# VALUE is a source constant; this only enables it). Scope it to one reviewed
# Vercel environment: Production for the App Store release, or Preview only
# when a separate durable staging backend exists. Never use "All Environments".
BIBLEQUEST_NATIVE_API_ORIGIN_ENABLED=false
# Green feature rollout. These preview features default on in the isolated
# green-features branch; set the master or one child to false for rollback.
NEXT_PUBLIC_GREEN_FEATURES_ENABLED=true
NEXT_PUBLIC_GUIDED_SCRIPTURE_ENABLED=true
NEXT_PUBLIC_PILGRIMAGES_ENABLED=true
NEXT_PUBLIC_SCRIPTURE_GAMES_ENABLED=true
NEXT_PUBLIC_SCRIPTURE_CONNECTIONS_ENABLED=true
NEXT_PUBLIC_BIBLE_TIMELINE_ENABLED=true
NEXT_PUBLIC_SEVEN_DAYS_MATCH_ENABLED=true
NEXT_PUBLIC_RHYTHM_BUILDER_ENABLED=true
# SERVER-ONLY approved rollback commit. Exactly 40 hexadecimal characters.
# Leave unset until the rollback authority approves a database/PWA-compatible
# target; the health/evidence contract reports only the validated SHA.
BIBLEQUEST_ROLLBACK_SHA=
# Server-only exact warning for the isolated sync-enabled staging build.
BIBLEQUEST_DEPLOYMENT_LABEL=

# --- Private operator console ---
# Comma-separated exact existing Supabase account emails. The console fails
# closed unless its server-only latch, allowlist, and Supabase are configured.
# Customer account sync can remain contained independently.
BIBLEQUEST_CONSOLE_AUTH_ENABLED=false
BIBLEQUEST_CONSOLE_ALLOWED_EMAILS=

# --- Plus AI (server-only) ---
# Generate Quest and MyShepherd use the pinned Haiku model only after the
# server verifies an authenticated Plus entitlement. Never add NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Supabase (optional in V1) ---
# The publishable key is safe for the browser. The independently rotatable
# secret key is server-only and used only by sealed application routes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Dedicated HMAC material keeps rate-limit identities isolated from database keys.
BIBLEQUEST_RATE_LIMIT_SECRET=
# Fail closed unless this exact build target has passed the complete account
# sync migration, RLS, restore, auth-provider, and PWA rollout gates.
NEXT_PUBLIC_ACCOUNT_SYNC_ENABLED=false

# Requires an account for prayers, quests, the arcade, and the journey — the
# four surfaces that accumulate something a reader would hate to lose. Reading
# is never gated. This latch alone cannot turn the gate on: it stays off unless
# NEXT_PUBLIC_ACCOUNT_SYNC_ENABLED is also true, so the app can never ask for a
# sign-up that would store nothing.
NEXT_PUBLIC_ACCOUNT_GATE_ENABLED=false

# Server-only rollout latch for private cross-device profile avatars.
BIBLEQUEST_AVATAR_SYNC_ENABLED=false

# --- Optional private Web Push reminders ---
# Keep both app and workflow latches off until migration 0024, encrypted
# secrets, two-user isolation, and supported-browser checks pass.
BIBLEQUEST_PUSH_ENABLED=false
# VAPID public/private base64url key pair and an operator mailto: or HTTPS URL.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
# Current AES-256-GCM key: exactly 32 random bytes encoded as base64.
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=
PUSH_SUBSCRIPTION_KEY_VERSION=1
# Optional rotation ring: JSON object mapping older integer versions to their
# 32-byte base64 keys. The current version/key above remains required.
PUSH_SUBSCRIPTION_ENCRYPTION_KEYS=
# At least 32 random characters. Store the same value as a GitHub Actions
# secret; never expose it to the browser.
PUSH_SCHEDULER_SECRET=

# --- Daily read-only production monitor (local/manual use) ---
# GitHub Actions stores the URL/key and Vercel values as repository secrets.
# The expected SHA is a non-secret repository variable updated after release.
BIBLEQUEST_MONITOR_SUPABASE_URL=
BIBLEQUEST_MONITOR_SUPABASE_ANON_KEY=
BIBLEQUEST_MONITOR_EXPECTED_SHA=
BIBLEQUEST_MONITOR_EXPECTED_AUTH_POSTURE=configured
# Safe local default; the production monitor currently overrides this to live.
BIBLEQUEST_MONITOR_EXPECTED_BILLING_MODE=coming-soon
# Safe local default; production currently pins the approved value to true.
BIBLEQUEST_MONITOR_EXPECTED_BILLING_PURCHASES_ENABLED=false
# Safe local default; production currently pins the approved value to true.
BIBLEQUEST_MONITOR_EXPECTED_BILLING_SUPPORT_ENABLED=false
# Optional Vercel aggregate runtime-error posture.
BIBLEQUEST_MONITOR_VERCEL_PROJECT_ID=
BIBLEQUEST_MONITOR_VERCEL_TEAM_ID=
BIBLEQUEST_MONITOR_VERCEL_TOKEN=

# --- Analytics (optional; privacy-first, no journal text ever) ---
# Events post to the Plausible Events API (cookieless, no fingerprinting)
# when BOTH the flag and domain are set. For production use the canonical
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=www.biblequest.co. Analytics remains off until a
# user explicitly opts in under Settings → Privacy & data. Offline events queue
# locally (maximum 50), are re-sanitized before retry, and are cleared
# immediately on opt-out.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Self-hosted Plausible? Use an HTTPS origin only (no path/query/hash/credentials).
# Invalid hosts silently disable analytics. Defaults to https://plausible.io.
NEXT_PUBLIC_PLAUSIBLE_HOST=

# --- Payments (optional and deny-by-default) ---
# Direct Stripe Billing is server-authoritative and deny-by-default. Local
# templates stay coming-soon; Production uses live only under recorded approval.
STRIPE_BILLING_MODE=coming-soon
# This second gate must be exactly true before subscription Checkout appears.
BIBLEQUEST_STRIPE_PURCHASES_ENABLED=false
# Separate gate for server-created one-time Support BibleQuest Checkout.
BIBLEQUEST_STRIPE_SUPPORT_ENABLED=false
# Separate gate and server-only Prices for one-time Arcade purchases.
BIBLEQUEST_STRIPE_ARCADE_ENABLED=false
# A future live rollout requires this separate approval latch as well.
STRIPE_LIVE_BILLING_APPROVED=false
# Keep all provider values blank while billing is coming-soon. Never commit
# values or paste them into chat. STRIPE_SECRET_KEY and webhook secret are
# server-only; the publishable key is non-secret but remains environment-owned.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_MONTHLY_PRICE_ID=
STRIPE_PLUS_ANNUAL_PRICE_ID=
STRIPE_PLUS_LIFETIME_PRICE_ID=
STRIPE_ARCADE_QUESTION_SKIP_PRICE_ID=
STRIPE_ARCADE_GAME_PASS_PRICE_ID=

# --- Bible editions ---
# The default KJV uses the keyless HelloAO Free Use Bible API; bundled WEB is
# the offline fallback. Neither needs an environment variable.
#
# Future licensed editions (optional; do not use API.Bible's non-commercial
# Starter access for monetized BibleQuest):
# SERVER-ONLY API.Bible key. BibleQuest Plus is commercial: add only exact Bible
# ids that the provider/publisher has licensed for this app's commercial plan.
# Catalog visibility alone is not permission; WEB is bundled and needs no key.
API_BIBLE_API_KEY=
API_BIBLE_COMMERCIALLY_LICENSED_BIBLE_IDS=

# Supabase Auth email is configured in the Supabase/SMTP provider dashboards;
# it does not read a Resend key from this app.
