# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.next-header-*/
/artifacts/synthetic-health/
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.p8

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Local Codex worktrees and generated media renders. These are large binary
# intermediates that .vercelignore already keeps out of deployments, so they
# must not re-enter history from another clone either — keep the rules here
# rather than in .git/info/exclude, which is local to a single machine.
/.codex-worktrees/
/output/live-wallpapers/
/output/instagram-square-v1/
/output/pixel-math-review-128/
/launch-evidence-*.local.md

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Capacitor / iOS. The generated build products, Pods, DerivedData, xcuserdata
# and the synced web bundle are ignored by `ios/.gitignore`, which the
# Capacitor CLI writes and maintains — do not duplicate those rules here or the
# two lists will drift. Only signing and distribution artifacts, which are not
# confined to ios/, belong at the root.
*.mobileprovision
*.ipa
*.dSYM.zip

# Native static-export staging and output. `.native/` is the filtered copy of
# the source tree that the native build stages before running `next build`
# with output:"export"; `out-native/` is the exported bundle Capacitor loads.
/.native/
/out-native/
