{
  "name": "biblequest",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:analytics": "vitest run tests/analytics.test.ts",
    "test:observability": "vitest run tests/observability.test.ts tests/observability-evidence.test.mjs",
    "test:headers": "NEXT_PUBLIC_SUPABASE_URL=https://header-fixture.supabase.co NEXT_PUBLIC_REVENUECAT_BILLING_MODE=live NEXT_PUBLIC_REVENUECAT_PUBLIC_KEY=rcb_headerfixture pnpm build && pnpm test:headers:built",
    "test:headers:built": "node --test tests/security-headers.integration.test.mjs",
    "test:service-worker": "vitest run tests/service-worker.test.ts",
    "check:seed": "node scripts/build-supabase-seed.mjs && git diff --exit-code -- supabase/seed.sql supabase/seed-manifest.json",
    "check:production-readiness": "node --env-file-if-exists=.env.local scripts/check-production-readiness.mjs",
    "evidence:launch": "node --env-file-if-exists=.env.local scripts/collect-launch-evidence.mjs",
    "test:launch-evidence": "pnpm evidence:launch --phase=preflight --fixture",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@revenuecat/purchases-js": "^1.47.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "framer-motion": "^12.42.2",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
